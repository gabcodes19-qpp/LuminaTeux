<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="560dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/lumina_intro_title"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/lumina_intro_title"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/lumina_intro_tagline"
            android:textSize="15sp"
            android:textColor="#A5F3FC" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/lumina_chip_white"
            android:text="@string/lumina_dev_badge"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#4F46E5" />

        <TextView
            android:id="@+id/lumina_intro_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textAlignment="center"
            android:textColor="#E0F2FE" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/lumina_intro_features"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp"
            android:gravity="start"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lumina_intro_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/lumina_intro_start"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#4F46E5"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lumina_intro_credit"
            android:textSize="11sp"
            android:textColor="#94A3B8" />
    </LinearLayout>
</ScrollView>
